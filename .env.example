APP_NAME='"Black Chat"'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost:8180
APP_PORT=8180

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5180

TRUSTED_PROXY=*

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=black_property
DB_USERNAME=sail
DB_PASSWORD=password

FORWARD_DB_PORT=3180

BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=reverb
CACHE_DRIVER=redis
SESSION_DRIVER=file
QUEUE_DRIVER=sync
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FORWARD_REDIS_PORT=6180

MAIL_MAILER=mailgun
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME="al@property.black.co.ke"
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="al@property.black.co.ke"
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME="Alphaxard from Black Property"
MAILGUN_DOMAIN="black.co.ke"
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

MAILPIT_PORT=1030
MAILPIT_DASHBOARD_PORT=9030

FORWARD_MAILPIT_PORT=1180
FORWARD_MAILPIT_DASHBOARD_PORT=9180

DEBUGBAR_ENABLED=true

PHPMYADMIN_PORT=7180

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8180/login/google/callback

AFRICASTKNG_USERNAME="black"
AFRICASTKNG_API_KEY=""
AFRICASTKNG_USERNAME_SANDBOX="sandbox"
AFRICASTKNG_API_KEY_SANDBOX=""

KOPOKOPO_CLIENT_ID_SANDBOX=""
KOPOKOPO_CLIENT_ID=""
KOPOKOPO_CLIENT_SECRET_SANDBOX=""
KOPOKOPO_CLIENT_SECRET=""
KOPOKOPO_API_KEY_SANDBOX=""
KOPOKOPO_API_KEY=""
KOPOKOPO_BASE_URL_SANDBOX="https://sandbox.kopokopo.com"
KOPOKOPO_BASE_URL="https://api.kopokopo.com"
KOPOKOPO_ENV="live"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=2180
REVERB_SCHEME=http
# The port/host the Reverb server itself binds to; keep these equal to
# REVERB_HOST/REVERB_PORT above unless you're proxying through something else.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=2180

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=

GEMINI_API_KEY=

# Generate with: sail artisan webpush:vapid
VAPID_SUBJECT="mailto:${MAIL_FROM_ADDRESS}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"